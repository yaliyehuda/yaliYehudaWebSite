<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <style>
        table, th, td {
            background-color: #cecaca;
            box-shadow: 0 5px 12px rgba(0 0 0 0.1);
        }

        .a {
            width: 100%;
            padding: 12px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
            transition: background 0.2s;
        }

        .a-button:hover {
            background-color: #76aef3;
        }
    </style>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
   
    <table style="width:100%">
        <tr style="height:100px">
           
            <td><a class ="a" href="homepage.aspx">home page</a></td>
            <td><a class ="a" herf="info.aspx">info page</a></td>
            <td><a class ="a" href="contact.aspx">contact page</a></td>
            <td><a class="a" href="gallery.aspx">gallery page</a></td>
            <%if (Session["nihol"] != "yes" && Session["user"] != "ok")
             {  %>
            <td><a class="a" href="login.aspx">login page</a></td>
            <td><a class="a" href="register.aspx">register page</a></td>
            <% } %>
            <%if (Session["nihol"] == "yes" || Session["user"] == "ok")
                {  %>
            <td><a class="a" href="logout.aspx">logout</a></td>
            <%} %>
            <%if (Session["nihol"] == "yes")
                { %>
            <td><a class="a" href="admin.aspx">admin page</a></td>
            <% } %>
            <%if (Session["nihol"] == "yes" || Session["user"] == "ok")
                {  %>
            <td><font color="black">welcome <%:Session["name"]%></font></td>
            <% } %>
            
        </tr>

    </table>
        <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
        
        </asp:ContentPlaceHolder>
    
</body>
</html>
